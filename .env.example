# Port HTTP du serveur
PORT=3000
# Dossier des données (base SQLite + secrets). À sauvegarder régulièrement.
DATA_DIR=./data
# Compte éditeur pour la console des licences (créé ou mis à jour au démarrage)
SUPERADMIN_EMAIL=vous@exemple.com
SUPERADMIN_PASSWORD=changez-moi
# Facultatif : imposer les secrets au lieu de data/secrets.json (hébergeurs sans disque persistant)
# SESSION_SECRET=
# LICENCE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
